---
const title = 'Farcaster';
const description =
  'Sovereign, single-binary gateway for agentic traffic — no server-held keys, self-hostable anywhere.';
// Canonical/OG base is derived from `site` in astro.config.mjs — the same value
// the sitemap is built from — so this page can't drift from it. Change the
// domain there, not here.
const siteUrl = new URL('/', Astro.site).href;
const githubUrl = 'https://github.com/zerkerlabs/farcaster';
const sdkUrl = 'https://github.com/zerkerlabs/farcaster/tree/main/sdk';
const issuesUrl = 'https://github.com/zerkerlabs/farcaster/issues';

// Mirrors README.md's "Local dev (mock OIDC)" quickstart verbatim (git clone +
// `make dev-auth`) — the landing page must never show an install path that
// diverges from the README.
const installCommand =
  'git clone https://github.com/zerkerlabs/farcaster.git && cd farcaster && make dev-auth';

const features = [
  {
    title: 'Single Go binary',
    body: 'One binary, one process. No JVM, no Python runtime, no sidecars to operate.',
  },
  {
    title: 'Self-host anywhere',
    body: 'Run it on-prem, in your own VPC, or air-gapped. Your infrastructure, your data.',
  },
  {
    title: 'No server-held key',
    body: 'x402 payment authorizations are verified, not custodied — the gateway never holds a private key.',
  },
  {
    title: 'MCP-native',
    body: 'Model Context Protocol traffic is proxied as a transparent pipe alongside plain HTTP.',
  },
  {
    title: 'x402 metering',
    body: 'Put a price on a tool or route and gate it behind a verified stablecoin payment authorization.',
  },
];

const links = [
  { label: 'Docs', href: '/docs/', body: 'Guides, concepts, and API reference.' },
  { label: 'GitHub', href: githubUrl, body: 'Source, issues, and releases.' },
  { label: 'SDKs', href: sdkUrl, body: 'Go and TypeScript clients (early).' },
  {
    label: 'Managed tier',
    href: issuesUrl,
    body: 'Hosted settlement, metering, and governance — commercial, talk to us.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — sovereign gateway for agentic traffic</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — sovereign gateway for agentic traffic`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} — sovereign gateway for agentic traffic`} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      :root {
        --bg: #ffffff;
        --fg: #111114;
        --muted: #55565c;
        --border: #e2e2e6;
        --surface: #f7f7f8;
        --accent: #111114;
        --accent-fg: #ffffff;
        color-scheme: light dark;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b0b0d;
          --fg: #f4f4f5;
          --muted: #a1a1aa;
          --border: #27272a;
          --surface: #17171a;
          --accent: #f4f4f5;
          --accent-fg: #111114;
        }
      }

      * {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.55;
      }

      a {
        color: inherit;
      }

      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--fg);
        outline-offset: 2px;
      }

      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--accent);
        color: var(--accent-fg);
        padding: 0.75rem 1rem;
        z-index: 10;
      }

      .skip-link:focus {
        left: 1rem;
        top: 1rem;
      }

      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 72rem;
        margin: 0 auto;
        padding: 1.5rem 1.5rem;
      }

      .logo {
        font-weight: 700;
        font-size: 1.125rem;
        text-decoration: none;
      }

      .site-nav {
        display: flex;
        gap: 1.5rem;
      }

      .site-nav a {
        text-decoration: none;
        font-size: 0.9375rem;
        color: var(--muted);
      }

      .site-nav a:hover {
        color: var(--fg);
      }

      main {
        max-width: 72rem;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      section {
        padding: 3.5rem 0;
        border-top: 1px solid var(--border);
      }

      .hero {
        border-top: none;
        padding-top: 2rem;
        text-align: center;
      }

      .hero h1 {
        font-size: clamp(2rem, 5vw, 3.25rem);
        line-height: 1.1;
        margin: 0 0 1rem;
      }

      .hero p {
        font-size: 1.125rem;
        color: var(--muted);
        max-width: 42rem;
        margin: 0 auto 2rem;
      }

      .cta-row {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .button {
        display: inline-block;
        padding: 0.7rem 1.4rem;
        border-radius: 0.375rem;
        text-decoration: none;
        font-weight: 600;
        border: 1px solid var(--fg);
      }

      .button.primary {
        background: var(--accent);
        color: var(--accent-fg);
      }

      .button.secondary {
        background: transparent;
        color: var(--fg);
      }

      h2 {
        font-size: 1.5rem;
        margin: 0 0 0.5rem;
      }

      .section-intro {
        color: var(--muted);
        margin: 0 0 1.5rem;
        max-width: 40rem;
      }

      pre {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 1rem 1.25rem;
        overflow-x: auto;
        margin: 0 0 0.75rem;
      }

      code {
        font-family:
          ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
        font-size: 0.875rem;
      }

      .install-note {
        color: var(--muted);
        font-size: 0.9375rem;
      }

      .install-note a {
        color: var(--fg);
      }

      .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        gap: 1.5rem;
      }

      .feature-grid h3 {
        font-size: 1.0625rem;
        margin: 0 0 0.4rem;
      }

      .feature-grid p {
        margin: 0;
        color: var(--muted);
        font-size: 0.9375rem;
      }

      .link-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        gap: 1rem;
      }

      .link-card {
        display: block;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 1.1rem 1.25rem;
        text-decoration: none;
        color: var(--fg);
      }

      .link-card:hover {
        border-color: var(--fg);
      }

      .link-card .link-label {
        font-weight: 600;
        display: block;
        margin-bottom: 0.25rem;
      }

      .link-card .link-body {
        color: var(--muted);
        font-size: 0.875rem;
      }

      footer {
        max-width: 72rem;
        margin: 0 auto;
        padding: 2rem 1.5rem 3rem;
        color: var(--muted);
        font-size: 0.875rem;
        border-top: 1px solid var(--border);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <a class="logo" href="/">Farcaster</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/docs/">Docs</a>
        <a href={githubUrl}>GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero">
        <h1>The sovereign gateway for agent traffic</h1>
        <p>
          A single self-hostable Go binary that routes, observes, and meters your agents — no
          server-held key, ever.
        </p>
        <div class="cta-row">
          <a class="button primary" href="/docs/">Read the docs</a>
          <a class="button secondary" href={githubUrl}>View on GitHub</a>
        </div>
      </section>

      <section aria-labelledby="install-heading">
        <h2 id="install-heading">Install</h2>
        <p class="section-intro">One command, self-hosted — no signup, no vendor:</p>
        <pre><code>{installCommand}</code></pre>
        <p class="install-note">
          Boots the gateway on <code>:8080</code> against a throwaway mock OIDC issuer. See the
          <a href={`${githubUrl}#quickstart`}>full quickstart in the README</a> for production OIDC
          setup.
        </p>
      </section>

      <section aria-labelledby="features-heading">
        <h2 id="features-heading">Why Farcaster</h2>
        <p class="section-intro">
          Built for operators who need to run agent infrastructure themselves, not hand it to a
          vendor.
        </p>
        <div class="feature-grid">
          {
            features.map((feature) => (
              <div>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section aria-labelledby="links-heading">
        <h2 id="links-heading">Links</h2>
        <div class="link-grid">
          {
            links.map((link) => (
              <a class="link-card" href={link.href}>
                <span class="link-label">{link.label}</span>
                <span class="link-body">{link.body}</span>
              </a>
            ))
          }
        </div>
      </section>
    </main>

    <footer>
      <p>Farcaster — Zerker's gateway to manage, analyze, and productize agents and agentic workflows.</p>
    </footer>
  </body>
</html>
